        "properties": {
          "theme": {"type": "string"},
          "open_pct": {"type": "number"},
          "high_pct": {"type": "number"},
          "low_pct": {"type": "number"},
          "close_pct": {"type": "number"},
          "confirmed": {"type": "boolean"},
          "gap_fade": {"type": "boolean"},
          "early_buy_suitable": {"type": "boolean"}
        }
      }
    },
    "candidates": {"type": "array"},
    "lessons": {"type": "array"}
  }
}
